{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "maheshcrmdf"
		},
		"AzureDataLakeStorage_ls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage_ls'"
		},
		"FileLoaction_ls_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'FileLoaction_ls'"
		},
		"AzureDataLakeStorage_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://maheshcrmst.dfs.core.windows.net/"
		},
		"FileLoaction_ls_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "C:\\project\\CRM_PROJECT"
		},
		"FileLoaction_ls_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "MAHESH RATHOD"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "maheshcrmdf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage_ls_accountKey": {
						"value": "[parameters('AzureDataLakeStorage_ls_accountKey')]"
					},
					"FileLoaction_ls_password": {
						"value": "[parameters('FileLoaction_ls_password')]"
					},
					"AzureDataLakeStorage_ls_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage_ls_properties_typeProperties_url')]"
					},
					"FileLoaction_ls_properties_typeProperties_host": {
						"value": "[parameters('FileLoaction_ls_properties_typeProperties_host')]"
					},
					"FileLoaction_ls_properties_typeProperties_userId": {
						"value": "[parameters('FileLoaction_ls_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}